# ---------------------------------------------------------------------------
# Inquiry notifications (OTP, enquiry alerts, call reminders)
# ---------------------------------------------------------------------------
# IMPORTANT: SMS/Email TEMPLATE CONTENT is NOT stored in .env.
# Templates are saved in MySQL tables: sms_templates, email_templates
# They are auto-seeded on first backend startup (scripts/seedTemplates.js).
# To change template text/IDs later, update the database — see:
#   docs/INQUIRY_NOTIFICATION_OPERATION_GUIDE.md
#
# .env only needs gateway CREDENTIALS below (no template IDs or OTP values).
# ---------------------------------------------------------------------------

APP_TIMEZONE=Asia/Kolkata

# SMTP (email OTP, enquiry emails, reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=cc@closedcircuit.in
SMTP_FROM_NAME=Closed Circuit AI Pvt Ltd

# Admin receives enquiry + reminder notifications
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_NAME=Admin

# SMS gateway (SMS Just / Kapsystem / Xtend — same pattern as College CSM)
# POST to gateway URL with query params: username, pass, senderid, dest_mobileno,
# message, response=Y, dltentityid, dlttempid
SMS_GATEWAY_BASE_URL=https://www.smsjust.com/blank/sms/user/urlsms.php
# Or Xtend: http://smsapi.xtendonline.com/blank/sms/user/urlsms.php
# SMS_GATEWAY_URL=  (alias for SMS_GATEWAY_BASE_URL)
SMS_BALANCE_URL=https://www.smsjust.com/blank/sms/user/balance_check.php
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=CIRCUI
SMS_DLT_ENTITY_ID=
# SMS_DLT_HEADER_ID=
# SMS_SEND_MODE=dlt_entity
#
# Fast2SMS alternative: https://www.fast2sms.com/dev/bulkV2
# SMS_API_KEY=
# SMS_SEND_MODE=dlt_variables
SMS_ENABLED=true

# Chrome Web OTP (mobile verification SMS must match DLT when binding is enabled)
SMS_WEB_OTP_BINDING=false
SMS_WEB_OTP_DOMAIN=closedcircuit.in
# PUBLIC_APP_URL=https://closedcircuit.in

# Optional: on startup, copy exact DLT-approved text into sms_templates (restart required)
# SMS_TEMPLATE_CONTENT_MOBILE_VERIFICATION_OTP=
