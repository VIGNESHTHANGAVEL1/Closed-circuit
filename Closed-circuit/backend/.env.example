# ---------------------------------------------------------------------------
# Inquiry notifications (OTP, enquiry alerts, call reminders)
# ---------------------------------------------------------------------------
# SMS templates: configured in .env below (SMS_TEMPLATE_*_ID / SMS_TEMPLATE_*_TEXT)
# Email templates: MySQL email_templates (auto-seeded on startup)
# ---------------------------------------------------------------------------

APP_TIMEZONE=Asia/Kolkata

# SMTP (email OTP, enquiry emails, reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=cc@closedcircuit.in
SMTP_FROM_NAME=Closed Circuit AI Pvt Ltd

# Admin receives enquiry + reminder notifications
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_NAME=Admin

# SMS gateway (SMS Just / Kapsystem — POST with query params)
SMS_ENABLED=true
SMS_GATEWAY_URL=https://www.smsjust.com/blank/sms/user/urlsms.php
SMS_GATEWAY_BASE_URL=https://www.smsjust.com/blank/sms/user/urlsms.php
SMS_BALANCE_URL=https://www.smsjust.com/blank/sms/user/balance_check.php
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=CIRCUI
SMS_DLT_ENTITY_ID=
SMS_SEND_MODE=dlt_entity

# Chrome Web OTP (optional — keep false unless DLT template includes @domain #otp)
SMS_WEB_OTP_BINDING=false
SMS_WEB_OTP_DOMAIN=closedcircuit.in

# SMS templates — use \n for line breaks; must match approved DLT text after {{variable}} replacement
SMS_TEMPLATE_MOBILE_OTP_ID=1107178097971411003
SMS_TEMPLATE_MOBILE_OTP_TEXT=Dear {{clientName}}\nThis is the OTP: {{otp}} to verify your mobile number.\nIt will be valid only for 2 mins.\nClosed Circuit AI Pvt Ltd\nhttps://closedcircuit.in

SMS_TEMPLATE_ENQUIRY_CLIENT_ID=1107178089489748985
SMS_TEMPLATE_ENQUIRY_CLIENT_TEXT=Dear {{clientName}},\nWe have received your enquery.\nWe will call/message you on your specified date and time to explain the details.\nClosed Circuit AI Pvt Ltd.

SMS_TEMPLATE_ENQUIRY_ADMIN_ID=1107178089528191303
SMS_TEMPLATE_ENQUIRY_ADMIN_TEXT=Enquery Received from {{clientName}} for a product {{lookingFor}}. We have to explain on {{preferredCallDate}} at {{preferredCallTime}}.\nClosed Circuit AI Pvt Ltd.

SMS_TEMPLATE_CALL_REMINDER_CLIENT_ID=1107178091751804980
SMS_TEMPLATE_CALL_REMINDER_CLIENT_TEXT=Dear {{clientName}},\nThis is a reminder regarding the discussion scheduled with you at {{preferredCallTime}}.\nKindly keep 10 minutes available for the conversation.\nClosed Circuit AI Pvt Ltd

SMS_TEMPLATE_CALL_REMINDER_ADMIN_ID=1107178091731358255
SMS_TEMPLATE_CALL_REMINDER_ADMIN_TEXT=Calendar Reminder\nDiscussion with: {{clientName}}\nOn his/her Mobile: {{mobileNumber}}\nProduct: {{lookingFor}}\nTime: {{preferredCallTime}}\nClosed Circuit AI Pvt Ltd

# Fast2SMS alternative (uncomment and set SMS_SEND_MODE=dlt_variables)
# SMS_API_KEY=
