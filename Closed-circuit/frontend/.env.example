# Backend API (required for MySQL + admin Enquiry dashboard)
# Local dev:
VITE_API_BASE_URL=http://localhost:5000
# Production (if API is on another host):
# VITE_API_BASE_URL=https://closedcircuit.in

# DigitalOcean Spaces CDN (marketing videos — must match backend DO_SPACES_* settings)
# VITE_DO_SPACES_CDN_BASE=https://lara.blr1.cdn.digitaloceanspaces.com
# VITE_DO_SPACES_BUCKET=lara
# VITE_DO_SPACES_REGION=blr1
# VITE_DO_SPACES_ROOT_FOLDER=Closed Circuit
# VITE_DO_SPACES_FLOW_VIDEO_FILE=flow_in_voice.mp4
# VITE_DO_SPACES_FAMILY_VIDEO_FILE=gifts_in_voice.mp4

# Optional: Google Sheets only when API is disabled (VITE_DISABLE_API=true)
# Must be a real deployed /exec URL — never use the placeholder below
# VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_REAL_DEPLOYMENT_ID/exec
